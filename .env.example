# Copy to .env locally and replace every placeholder. Never commit .env.
# Before deployment, rotate the previously exposed ORS API key and JWT signing secret.
# Invalidate tokens signed with the exposed JWT secret after rotation.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/shareride_mobile
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
ORS_API_KEY=REPLACE_WITH_OPENROUTESERVICE_API_KEY
ORS_BASE_URL=https://api.openrouteservice.org
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
